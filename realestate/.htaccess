# Shelter and Sense v3 — Apache config for shared hosting (works in a sub-directory).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Never serve internals.
<FilesMatch "^(config\.php|config\.sample\.php|bootstrap\.php|cron\.php|composer\.(json|lock)|.*\.md|.*\.sqlite.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|views|data|tests|docs)(/|$) - [F,L]
  # Pass Authorization header through to PHP (needed by the API on some CGI hosts).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
