# Required
DATABASE_URL="postgresql://postgres@localhost:5432/majlis"
APP_URL="http://localhost:3000"
# 32+ random bytes; used to sign file URLs and sandbox webhooks
APP_SECRET="change-me-to-a-long-random-string"

# Payments: "sandbox" (default, no real money) or "stripe"
PAYMENT_PROVIDER="sandbox"
# Sandbox is refused when NODE_ENV=production unless this is set (staging/demo only — never on a live site)
# ALLOW_SANDBOX_PAYMENTS="1"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: enables AI writing assistants (falls back to templates when unset)
ANTHROPIC_API_KEY=""

# Optional: transactional email (outbox is always written to the DB; set to deliver via Resend)
RESEND_API_KEY=""
EMAIL_FROM="Majlis <no-reply@example.com>"

# Local file storage root for private uploads (swap for S3/R2 in production)
STORAGE_DIR="./storage"
